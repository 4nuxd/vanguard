{
  "manifest_version": 3,
  "name": "VirusTotal Smart Inspector",
  "version": "1.0",
  "description": "Highlights IPs on webpages and shows VirusTotal reputation instantly. Includes advanced popup search, history, and inline tooltips.",
  "icons": {
    "16": "icons/icon128.png",
    "48": "icons/icon128.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon128.png",
      "48": "icons/icon128.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://www.virustotal.com/*",
    "https://www.virustotal.com/api/*",
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["tooltip.css"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "tooltip.css"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "options_ui": {
    "page": "history.html",
    "open_in_tab": true
  }
}
